{
  "manifest_version": 3,
  "name": "Beyond 2x: YT Speed Booster",
  "description": "Think 2x is too slow? This extension lets you speed up YouTube beyond 2x!",
  "version": "1.0",
  "permissions": ["scripting", "activeTab"],
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "beyond-2x@extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
